{
  "name": "DidaoUI-uniapp-docs",
  "version": "1.0.0",
  "private": true,
  "description": "DidaoUI-uniapp 组件库文档站 — VitePress + 手机预览",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n docs,h5 -c gold,blue \"vitepress dev --port 5173\" \"npm run dev:h5\"",
    "dev:docs": "vitepress dev --port 5173",
    "dev:h5": "cd h5-demo && npm run dev:h5",
    "build": "node scripts/build-docs.mjs",
    "preview": "vitepress preview --port 5173"
  },
  "dependencies": {
    "@didaoktv/didaoui-uniapp": "^1.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0",
    "vitepress": "^1.4.0"
  }
}
